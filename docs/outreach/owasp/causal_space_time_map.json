  "organizational_nodes": [
    {
      "id": "agentic-security-working-group",
      "classification": "official_working_group",
      "name": "Agentic Security Working Group",
      "channel": "#team-genai-agentic-security-initiative",
      "role": "Primary review and routing point for the CML benchmark and ASI crosswalk."
    },
    {
      "id": "red-team-evaluation-initiative",
      "classification": "official_initiative",
      "name": "AI Red Teaming & Evaluation",
      "channel": "#team-genai-redteam",
      "role": "Methodology, benchmark rigor, adversarial testing, and external harness interoperability."
    },
    {
      "id": "mcp-security-workstream",
      "classification": "documented_workstream",
      "name": "MCP security guidance",
      "channel": null,
      "role": "Tool-server authorization, validation, session isolation, third-party risk, and chained-tool security."
    },
    {
      "id": "asi06-memory-guard",
      "classification": "reference_implementation",
      "name": "OWASP Agent Memory Guard",
      "channel": null,
      "role": "Persistent-memory read/write defense and a natural integration target for ASB-12."
    }
  ],
  "spaces": [
    {
      "id": "intent",
      "question": "What user objective must remain invariant?",
      "cml_evidence": [
        "intent",
        "constraints",
        "expected_postconditions"
      ]
    },
    {
      "id": "authority",
      "question": "Who may authorize this transition now?",
      "cml_evidence": [
        "authorization",
        "scope",
        "expiry",
        "approval_refs"
      ]
    },
    {
      "id": "tool_mcp",
      "question": "Which exact tool and server performed the side effect?",
      "cml_evidence": [
        "dispatch",
        "tool_name",
        "server_ref",
        "request_digest"
      ]
    },
    {
      "id": "external_state",
      "question": "What changed outside the model?",
      "cml_evidence": [
        "state_before",
        "state_after",
        "outcome"
      ]
    },
    {
      "id": "verification",
      "question": "Did an independent observer confirm the user-level invariant?",
      "cml_evidence": [
        "verification",
        "checks",
        "verifier",
        "verdict"
      ]
    },
    {
      "id": "recovery",
      "question": "What bounded transition restored trust?",
      "cml_evidence": [
        "recovery",
        "causal_parent_ids",
        "parent_digests"
      ]
    },
    {
      "id": "memory",
      "question": "Can untrusted state persist and influence a future session?",
      "cml_evidence": [
        "memory_write_lineage",
        "quarantine",
        "rollback",
        "future_read_verification"
      ]
    }
  ],
  "time_states": [
    {
      "id": "T0",
      "state": "declared_intent"
    },
    {
      "id": "T1",
      "state": "plan_and_preconditions"
    },
    {
      "id": "T2",
      "state": "current_authorization"
    },
    {
      "id": "T3",
      "state": "tool_dispatch"
    },
    {
      "id": "T4",
      "state": "observed_external_effect"
    },
    {
      "id": "T5",
      "state": "independent_verification"
    },
    {
      "id": "T6",
      "state": "containment"
    },
    {
      "id": "T7",
      "state": "minimal_recovery"
    },
    {
      "id": "T8",
      "state": "verified_final_state"
    },
    {
      "id": "T9",
      "state": "future_session_or_reuse"
    }
  ],
  "transitions": [
    {
      "from": "T0",
      "to": "T1",
      "guard": "plan preserves declared constraints"
    },
    {
      "from": "T1",
      "to": "T2",
      "guard": "authority is current and scoped"
    },
    {
      "from": "T2",
      "to": "T3",
      "guard": "dispatch is the smallest authorized side effect"
    },
    {
      "from": "T3",
      "to": "T4",
      "guard": "record actual external outcome, not tool wording alone"
    },
    {
      "from": "T4",
      "to": "T5",
      "guard": "independent verifier checks critical postconditions"
    },
    {
      "from": "T5",
      "to": "T8",
      "guard": "all critical checks pass"
    },
    {
      "from": "T5",
      "to": "T6",
      "guard": "divergence or uncertainty is detected"
    },
    {
      "from": "T6",
      "to": "T7",
      "guard": "recovery is bounded, reversible, and parent-bound"
    },
    {
      "from": "T7",
      "to": "T8",
      "guard": "independent verification confirms restoration"
    },
    {
      "from": "T8",
      "to": "T9",
      "guard": "persistent context is provenance-checked before reuse"
    }
  ],
  "entry_route": [
    {
      "order": 1,
      "target": "agentic-security-working-group",
      "trigger": "Publish crosswalk and benchmark request.",
      "completion_evidence": "Slack post or meeting reference."
    },
    {
      "order": 2,
      "target": "red-team-evaluation-initiative",
      "trigger": "ASI acknowledges evaluation relevance or no routing response after five business days.",
      "completion_evidence": "Red-team channel post referencing the ASI submission."
    },
    {
      "order": 3,
      "target": "mcp-security-workstream",
      "trigger": "Crosswalk feedback confirms tool/MCP scenarios as a useful evaluation slice.",
      "completion_evidence": "Review request tied to ASB-01, ASB-04, ASB-06, and ASB-11."
    },
    {
      "order": 4,
      "target": "asi06-memory-guard",
      "trigger": "ASB-12 persistent-memory fixture and adapter are runnable.",
      "completion_evidence": "Issue or PR proposing Memory Guard integration."
    }
  ],
  "non_claims": [
    "This map is not an official OWASP organizational chart.",
