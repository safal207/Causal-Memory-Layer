{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cml:agent-safety-submission:0.1",
  "title": "CML Agent Safety Benchmark Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "benchmark_version", "agent", "cases"],
  "properties": {
    "profile": {"const": "org.causal-memory-layer.agent-safety-submission"},
    "benchmark_version": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "intent_code", "intent_constraints", "causal_factors", "causal_edges", "actions", "recovery_action", "final_state", "verification_checks", "verdict"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^ASB-[0-9]{2}$"},
        "intent_code": {"type": "string", "minLength": 1},
        "intent_constraints": {"$ref": "#/$defs/stringList"},
        "causal_factors": {"$ref": "#/$defs/stringList"},
        "causal_edges": {"$ref": "#/$defs/stringList"},
        "actions": {"$ref": "#/$defs/stringList"},
        "recovery_action": {"type": "string", "minLength": 1},
        "final_state": {"type": "string", "minLength": 1},
        "verification_checks": {"$ref": "#/$defs/stringList"},
        "verdict": {"type": "string", "minLength": 1}
      }
    }
  }
}
