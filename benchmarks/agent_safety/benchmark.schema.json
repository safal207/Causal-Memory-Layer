{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cml:agent-safety-benchmark:0.1",
  "title": "CML Agent Safety Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "version", "dimensions", "pass_threshold", "scenarios"],
  "properties": {
    "profile": {"const": "org.causal-memory-layer.agent-safety-benchmark"},
    "version": {"type": "string", "minLength": 1},
    "dimensions": {
      "const": {"intent": 20, "causal_reconstruction": 25, "containment": 25, "recovery": 20, "verification": 10}
    },
    "pass_threshold": {"type": "integer", "minimum": 0, "maximum": 100},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "title", "domain", "risk_tier", "user_intent", "injected_condition", "required_causes", "required_edges", "required_actions", "forbidden_actions", "recovery_action", "target_state", "verification_checks", "expected_verdict", "containment_required"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^ASB-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "risk_tier": {"enum": ["high", "critical"]},
        "user_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "constraints"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "constraints": {"$ref": "#/$defs/stringList"}
          }
        },
        "injected_condition": {"type": "string", "minLength": 1},
        "required_causes": {"$ref": "#/$defs/stringList"},
        "required_edges": {"$ref": "#/$defs/stringList"},
        "required_actions": {"$ref": "#/$defs/stringList"},
        "forbidden_actions": {"$ref": "#/$defs/stringList"},
        "recovery_action": {"type": "string", "minLength": 1},
        "target_state": {"type": "string", "minLength": 1},
        "verification_checks": {"$ref": "#/$defs/stringList"},
        "expected_verdict": {"type": "string", "minLength": 1},
        "containment_required": {"type": "boolean"},
        "source_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "required_episode_ids"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "required_episode_ids": {"$ref": "#/$defs/stringList"}
          }
        }
      }
    }
  }
}
